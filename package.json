{
  "name": "astrolumina-booking-api",
  "version": "2.0.0",
  "description": "Cal.com Booking API for AstroLumina — astrological session scheduling",
  "main": "dist/server.js",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "clean": "rm -rf node_modules && rm -rf dist",
    "d1:migrate": "tsx src/db/migrate.ts",
    "render-build": "npm run clean && npm install --include=dev && npm run build",
    "c_u_i_b": "npm run clean && npm update --ignore-scripts && npm install --include=dev && npm run build",
    "c_u_i_b_d": "npm run c_u_i_b && npm run dev"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "@sentry/node": "^10.45.0",
    "@sentry/profiling-node": "^11.0.0",
    "axios": "^1.18.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "escape-html": "^1.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "morgan": "^1.12.0",
    "resend": "^6.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/escape-html": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "allowScripts": {
    "@sentry/node-cpu-profiler": true,
    "esbuild": true
  }
}
